# --- IDEs & OS (Essential for Teams) ---
.idea/
.vscode/
.DS_Store
*.swp
Thumbs.db

# --- Next.js / Frontend ---
**/node_modules/    <-- The ** covers any subfolder
**/.next/
**/out/
**/build/
.env*.local         <-- Keeps teammate secrets off GitHub

# --- ASP.NET Core / Backend ---
**/bin/
**/obj/
*.user
*.suo
UserSecretsId
# Ignore personal dev settings but keep main appsettings.json
appsettings.Development.json

# --- Docker & Databases ---
postgres_data/      <-- Stops the actual database files from being committed
.env                <-- Stops the root Docker secrets from being committed

# --- Miscellaneous ---
*.log
npm-debug.log*